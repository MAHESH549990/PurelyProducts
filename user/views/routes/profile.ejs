<%-layout("/boilerplate/userBoiler")%>
<div class="container-fluid m-1 bg-white p-2 rounded-5 row tex-align-center">
  <h1 class="offset-lg-1 offset-md-1 offset-sm-0" style="text-align: center;">Hello <b><%=user.username%></b> Welcome to <i class="fa-brands fa-shopware" style="color:rgb(215, 9, 9)" id="logo"></i></i>PurelyProducts</h1>
  <div class="user-profile-img col-lg-3 col-md-4 col-sm-10 mt-5 offset-lg-1 offset-md-1 offset-sm-0">
     <img src="/images/user_profile.png">
  </div>
  <div class="about-user col-lg-6 col-md-6 col-sm-10 mt-5 d-flex flex-wrap">
    <h3 class="mt-2"><b>Name:</b> <%=user.username%></h3>
    <h3 class="mt-3 flex-wrap"><b>Email:</b> <%=user.email%></h3>  
  </div>
</div>
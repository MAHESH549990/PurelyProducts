
<%- layout("/boilerplate/userBoiler") %>

<div class="container py-4 py-md-5">

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- Welcome Header -->
        <div class="card-body text-center p-4 p-md-5 border-bottom bg-white">
            <div class="mb-3">
                <i class="fa-brands fa-shopware text-danger"
                   id="logo"
                   style="font-size: 3rem;"></i>
            </div>

            <h2 class="fw-bold mb-2">
                Hello, <%= user.username %>!
            </h2>

            <p class="text-secondary mb-0">
                Welcome to <span class="fw-semibold text-dark">PurelyProducts</span>
            </p>
        </div>

        <!-- Profile Information -->
        <div class="card-body p-4 p-md-5">

            <div class="row align-items-center g-4">

                <!-- Profile Image -->
                <div class="col-12 col-md-4 text-center">
                    <img
                        src="/images/user_profile.png"
                        alt="Customer profile"
                        class="img-fluid rounded-circle border p-2 bg-light"
                        style="width: 160px; height: 160px; object-fit: contain;"
                    >
                </div>

                <!-- User Details -->
                <div class="col-12 col-md-8">

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h4 class="fw-bold mb-0">Profile Information</h4>
                        <i class="fa-solid fa-circle-user text-secondary fs-4"></i>
                    </div>

                    <div class="border rounded-3 p-3 mb-3">
                        <div class="text-secondary small mb-1">
                            <i class="fa-solid fa-user me-2"></i>
                            Full Name
                        </div>
                        <h5 class="fw-semibold mb-0">
                            <%= user.username %>
                        </h5>
                    </div>

                    <div class="border rounded-3 p-3">
                        <div class="text-secondary small mb-1">
                            <i class="fa-solid fa-envelope me-2"></i>
                            Email Address
                        </div>
                        <h5 class="fw-semibold mb-0 text-break">
                            <%= user.email %>
                        </h5>
                    </div>

                </div>
            </div>

            <!-- Address Section -->
            <div class="mt-5 pt-4 border-top">

                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">

                    <div>
                        <h4 class="fw-bold mb-1">
                            <i class="fa-solid fa-location-dot text-danger me-2"></i>
                            Your Addresses
                        </h4>
                        <p class="text-secondary mb-0">
                            Manage your saved delivery addresses.
                        </p>
                    </div>

                </div>

                <% if (Useraddress.length > 0) { %>

                    <div class="row g-4">

                        <% for (let address of Useraddress) { %>

                            <div class="col-12 col-md-6">

                                <div class="card h-100 border rounded-3 shadow-sm">

                                    <div class="card-body p-4">

                                        <div class="d-flex align-items-center mb-3">
                                            <div class="me-3 text-danger fs-4">
                                                <i class="fa-solid fa-house"></i>
                                            </div>
                                            <h5 class="fw-bold mb-0">
                                                Delivery Address
                                            </h5>
                                        </div>

                                        <div class="mb-3">
                                            <p class="text-secondary small mb-1">
                                                State
                                            </p>
                                            <p class="fw-semibold mb-0">
                                                <%= address.state %>
                                            </p>
                                        </div>

                                        <div class="mb-3">
                                            <p class="text-secondary small mb-1">
                                                City
                                            </p>
                                            <p class="fw-semibold mb-0">
                                                <%= address.city %>
                                            </p>
                                        </div>

                                        <div class="mb-4">
                                            <p class="text-secondary small mb-1">
                                                Location
                                            </p>
                                            <p class="fw-semibold mb-0 text-break">
                                                <%= address.location %>
                                            </p>
                                        </div>

                                        <div class="d-flex flex-wrap gap-2 pt-3 border-top">

                                            <form
                                                action="/users/profile/<%= address._id %>?_method=DELETE"
                                                method="post"
                                                onsubmit="return confirm('Are you sure you want to delete this address?');"
                                            >
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm">
                                                    <i class="fa-solid fa-trash me-1"></i>
                                                    Delete
                                                </button>
                                            </form>

                                            <form
                                                action="/users/profile/<%= address._id %>/update"
                                                method="get"
                                            >
                                                <button type="submit"
                                                        class="btn btn-outline-primary btn-sm">
                                                    <i class="fa-solid fa-pen-to-square me-1"></i>
                                                    Update Address
                                                </button>
                                            </form>

                                        </div>

                                    </div>
                                </div>

                            </div>

                        <% } %>

                    </div>

                <% } else { %>

                    <div class="text-center border rounded-3 p-4 p-md-5 bg-light">

                        <i class="fa-solid fa-map-location-dot text-secondary mb-3"
                           style="font-size: 2.5rem;"></i>

                        <h5 class="fw-bold">No addresses added yet</h5>

                        <p class="text-secondary mb-3">
                            Add a delivery address to make your orders easier to manage.
                        </p>

                        <form action="/users/profile/location" method="get">
                            <button type="submit" class="btn btn-success">
                                <i class="fa-solid fa-plus me-2"></i>
                                Add Your Address
                            </button>
                        </form>

                    </div>

                <% } %>

            </div>

        </div>
    </div>
</div>

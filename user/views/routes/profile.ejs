<%-layout("/boilerplate/userBoiler")%>
<div class="container bg-white p-5 rounded-3 my-4">
  <h1 class="offset-lg-1 offset-md-1 offset-sm-0" style="text-align: center;">Hello <b><%=user.username%></b> Welcome to <i class="fa-brands fa-shopware" style="color:rgb(215, 9, 9)" id="logo"></i></i>PurelyProducts</h1>
  <div class="user-profile-img col-lg-3 col-md-4 col-sm-10 mt-5 offset-lg-1 offset-md-1 offset-sm-0">
     <img src="/images/user_profile.png">
  </div>
  <div class="about-user col-lg-6 col-md-6 col-sm-10 mt-5 d-flex flex-wrap">
    <h3 class="mt-2"><b>Name:</b> <%=user.username%></h3>
    <h3 class="mt-3 flex-wrap"><b>Email:</b> <%=user.email%></h3>  
  </div>
  <form action="/users/profile/location" method="get">
  <button class="btn btn-outline-danger">Add address</button>
  </form>

  <%if(Useraddress.length>0){%>
  <div class="mt-5">
      <h1>Your addresses</h1>
                  <%for(let address of Useraddress){%>
                    <div class="my-4 bg-dark text-white my-4 rounded-5 p-3">
                      <h5>
                        State: <%=address.state%><br/>
                        City: <%=address.city%><br/>
                        Location: <%=address.location%>
                      </h5> 
                      <form action="/users/profile/<%=address._id%>?_method=DELETE" method="post" onclick="return confirm('Are you sure to delete this address ?');">
                          <button class="btn btn-outline-danger my-3">Delete</button>
                      </form>

                      <form action="/users/profile/<%=address._id%>/update" method="get">
                          <button class="btn btn-outline-warning my-3">Update Address</button>
                      </form>
                      </div>
                  <%}%>
      
  </div>
  <%}%>
</div>
<%- layout("/boilerplate/userBoiler") %>

<div class="container py-4 py-md-5">

    <!-- Product Details -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="row g-0 align-items-center">

            <!-- Product Image -->
            <div class="col-12 col-md-5 p-3 p-md-4">
                <div class="bg-light rounded-4 d-flex align-items-center justify-content-center p-3"
                     style="min-height: 320px;">
                    <img
                        src="<%= item.image.url %>"
                        alt="<%= item.name %>"
                        class="img-fluid rounded-3"
                        style="max-height: 400px; width: 100%; object-fit: contain;"
                    >
                </div>
            </div>

            <!-- Product Information -->
            <div class="col-12 col-md-7">
                <div class="card-body p-4 p-md-5">

                    <span class="badge bg-success-subtle text-success mb-3 px-3 py-2">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Product Details
                    </span>

                    <h2 class="fw-bold mb-3">
                        <%= item.name %>
                    </h2>

                    <h3 class="text-success fw-bold mb-3">
                        ₹<%= item.price.toLocaleString("en-IN") %>
                    </h3>

                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div>
                            <% for (let i = 1; i <= item.rating; i++) { %>
                                <i class="fa-solid fa-star text-warning"></i>
                            <% } %>
                        </div>
                        <span class="text-secondary small">
                            <%= item.rating %>/5 Rating
                        </span>
                    </div>

                    <hr class="my-4">

                    <h5 class="fw-bold mb-2">Product Description</h5>
                    <p class="text-secondary lh-lg mb-4">
                        <%= item.description %>
                    </p>

                    <!-- Add To Cart -->
                    <form method="post" action="/product/<%= item._id %>/cart">

                        <label for="quantity" class="form-label fw-semibold">
                            <i class="fa-solid fa-box me-2 text-success"></i>
                            Select Quantity
                        </label>

                        <select
                            id="quantity"
                            name="quantity"
                            class="form-select mb-4"
                            style="max-width: 180px;"
                        >
                            <option value="1" selected>1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                            <option value="7">7</option>
                        </select>

                        <button type="submit" class="btn btn-success btn-lg px-4">
                            <i class="fa-solid fa-cart-shopping me-2"></i>
                            Add To Cart
                        </button>

                    </form>

                </div>
            </div>
        </div>
    </div>


    <!-- Reviews Section -->
    <div class="mb-4">
        <h3 class="fw-bold mb-2">
            <i class="fa-solid fa-star-half-stroke text-warning me-2"></i>
            Customer Reviews
        </h3>
        <p class="text-secondary mb-0">
            Read customer feedback and share your experience.
        </p>
    </div>


    <!-- Add Review Form -->
    <% if (currUser) { %>

        <div class="card border-0 shadow-sm rounded-4 mb-5">
            <div class="card-body p-4 p-md-5">

                <h4 class="fw-bold mb-4">
                    <i class="fa-solid fa-pen-to-square text-success me-2"></i>
                    Write a Review
                </h4>

                <form
                    action="/users/<%= item._id %>/reviews"
                    method="post"
                    class="needs-validation"
                    novalidate
                >

                    <!-- Comment -->
                    <div class="mb-4">
                        <label for="comment" class="form-label fw-semibold">
                            Your Comment
                        </label>

                        <textarea
                            name="review[comment]"
                            placeholder="Share your experience with this product..."
                            class="form-control"
                            id="comment"
                            rows="4"
                            minlength="5"
                            required
                        ></textarea>

                        <div class="valid-feedback">
                            Comment looks good!
                        </div>

                        <div class="invalid-feedback">
                            Please enter a comment with at least 5 characters.
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-4">
                        <label for="image" class="form-label fw-semibold">
                            Review Image
                            <span class="text-secondary fw-normal">(Optional)</span>
                        </label>

                        <input
                            type="url"
                            name="review[image][url]"
                            placeholder="Enter image URL"
                            class="form-control"
                            id="image"
                        >

                        <div class="invalid-feedback">
                            Please enter a valid image URL.
                        </div>
                    </div>

                    <!-- Rating -->
                    <div class="mb-4">
                        <label for="rating" class="form-label fw-semibold">
                            Your Rating
                        </label>

                        <div class="d-flex align-items-center gap-3">
                            <input
                                type="range"
                                class="form-range"
                                style="max-width: 300px;"
                                step="1"
                                name="review[rating]"
                                id="rating"
                                min="1"
                                max="5"
                                value="5"
                                required
                            >

                            <span class="badge bg-warning text-dark px-3 py-2"
                                  id="ratingValue">
                                5/5
                            </span>
                        </div>

                        <div class="text-warning mt-2">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success px-4 py-2">
                        <i class="fa-solid fa-paper-plane me-2"></i>
                        Submit Review
                    </button>

                </form>
            </div>
        </div>

    <% } else { %>

        <div class="alert alert-light border rounded-3 mb-5">
            <i class="fa-solid fa-circle-info text-success me-2"></i>
            Please log in to write a review.
        </div>

    <% } %>


    <!-- Display Reviews -->
    <% if (item.reviews.length) { %>

        <div class="row g-4">

            <% for (let review of item.reviews) { %>

                <div class="col-12 col-md-6">

                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">

                            <!-- Reviewer Information -->
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-success-subtle text-success rounded-circle
                                            d-flex align-items-center justify-content-center me-3"
                                     style="width: 48px; height: 48px; flex-shrink: 0;">
                                    <i class="fa-solid fa-user fs-5"></i>
                                </div>

                                <div>
                                    <h6 class="fw-bold mb-1 text-break">
                                        @<%= review.owner.username %>
                                    </h6>

                                    <p class="text-secondary small mb-0">
                                        <i class="fa-regular fa-calendar me-1"></i>
                                        <%= review.createdAt.toLocaleString("en-IN") %>
                                    </p>
                                </div>
                            </div>

                            <!-- Review Rating -->
                            <div class="mb-3">
                                <% for (let rating = 1; rating <= review.rating; rating++) { %>
                                    <i class="fa-solid fa-star text-warning"></i>
                                <% } %>

                                <span class="text-secondary small ms-1">
                                    <%= review.rating %>/5
                                </span>
                            </div>

                            <!-- Review Comment -->
                            <p class="mb-3" style="white-space: pre-wrap; overflow-wrap: anywhere;"><%= review.comment %></p>

                            <!-- Review Image -->
                            <% if (review.image && review.image.url) { %>
                                <div class="bg-light rounded-3 p-2 mb-3 text-center">
                                    <img
                                        src="<%= review.image.url %>"
                                        alt="Review image"
                                        class="img-fluid rounded-3"
                                        style="max-height: 250px; object-fit: contain;"
                                    >
                                </div>
                            <% } %>

                            <!-- Delete Review -->
                            <% if (currUser && currUser._id.equals(review.owner._id)) { %>

                                <hr>

                                <form
                                    action="/users/<%= item._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="post"
                                    onsubmit="return confirm('Are you sure you want to delete this review?');"
                                >
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="fa-solid fa-trash me-2"></i>
                                        Delete Review
                                    </button>
                                </form>

                            <% } %>

                        </div>
                    </div>

                </div>

            <% } %>

        </div>

    <% } else { %>

        <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">
            <div class="mb-3">
                <i class="fa-regular fa-comments text-secondary"
                   style="font-size: 3rem;"></i>
            </div>

            <h5 class="fw-bold mb-2">No Reviews Yet</h5>

            <p class="text-secondary mb-0">
                Be the first to share your experience with this product!
            </p>
        </div>

    <% } %>

</div>

<script>
    const ratingInput = document.getElementById("rating");
    const ratingValue = document.getElementById("ratingValue");

    if (ratingInput && ratingValue) {
        ratingInput.addEventListener("input", function () {
            ratingValue.textContent = this.value + "/5";
        });
    }
</script>
<%-layout("/boilerplate/boilerplate")%>
<body>
  <div class="bg-white p-2 rounded-3 w-100 h-100"  id="row-for-image">
    <div class="row">
    <div class="col-lg-5 col-md-6 col-sm-12">
    <img src="<%=item.image.url%>" class="rounded-3 card-img-item">
    </div>
    <!-- <div class="card-img-overlay"></div> -->
    <div class="card-body-item col-lg-6 col-md-6 col-sm-12 mt-5">
    <p class="card-text h3"><b><%=item.name%></b><br/>&#8377; <%=item.price.toLocaleString("en-IN") %></p>
    <p class="card-text h5">
      <%=item.description%>
    </p>
    <div class="h3">
     <% for(let i = 1; i <= item.rating; i++) { %>
      <i class="fa-solid fa-star text-warning"></i>
     <% } %>
     <span><%= item.rating %>/5</span>
    </div>
    <div class="butns d-flex flex-wrap">
      <button class="btn btn-outline-success me-4" >Place Order</button>
      <form method="post" action="/home/<%=item._id%>">
      <button class="btn btn-outline-primary">Add To Cart</button>
      </form>
    </div>
  </div>
  </div>
  </div>

   
   <div class="bg-white mt-5 mb-3 w-100 h-100 rounded-3 p-2">
    <div class="row my-5">
            <h1 class="mt-3 mb-5"><i class="fa-solid fa-star-half"></i>Add Reviews</h1>
            <form action="/users/<%=item._id%>/reviews" method="post"
            class="needs-validation" novalidate>
            <div class="mt-3 mb-3 col-sm-12 col-lg-6 col-lg-8">
                <label for="comment" class="form-label">Comment: </label>
                <textarea 
                    type="text" 
                    name="review[comment]" 
                    placeholder="Enter comment" class="form-control border" 
                    id="comment" 
                    rows="4"
                    minlength="5" 
                    required></textarea>
                <div class="valid-feedback">
                  Comment looks good!
                </div>
                <div class="invalid-feedback">
                  Please enter comment!
                </div>
              </div>

          <div class="mt-3 mb-3 col-sm-12 col-lg-6 col-lg-8">
                <label for="image" class="form-label">Add image: </label>
                <input
                    type="text" 
                    name="review[image][url]" 
                    placeholder="Enter image URL" class="form-control border" 
                    id="image" 
                  >
                <div class="valid-feedback">
                  Image URL looks good!
                </div>
                <div class="invalid-feedback">
                  Please enter Image URL!
                </div>
              </div>


              <div class="mt-3 mb-3 col-sm-12 col-lg-6 col-lg-8">
                <label for="rating" class="form-label">Rating: </label>
                <input type="range" step="1" name="review[rating]"   id="rating" min="1" max="5"  required>
              </div>
              <button class="btn btn-dark my-4">Add Review</button>
        </form>
    </div>
    <hr style="height:0.2rem !important; background-color:black" class="my-3">
    <div class="row">
    <h1 class="my-5"><i class="fa-solid fa-star-half"></i> Reviews</h1>
     <%for(review of item.reviews){%>
            <div class="col-lg-6 col-md-6 col-sm-12 my-3  border-0">
            <h4>@Mahesh Bhatt</h4>
            <%if(review.image.url){%>
              <img src="<%=review.image.url%>" class=" col-lg-3 col-md-4 col-sm-9 my-1 w-50 h-50 rounded-3"/>
            <%}%>
            <div class="card-text">
             <p>
              <%=review.comment%><br/>
              <%for(let rating=1;rating<=review.rating;rating++){%>
                 <i class="fa-solid fa-star text-danger"></i>
              <%}%>
              /5</p>
               <form action="/users/<%=item._id%>/reviews/<%=review._id%>?_method=DELETE" method="post" onclick="return confirm('Are you sure to delete this review ?');">
                <button class="btn btn-outline-danger my-2">Delete</button>
               </form>
            </div>
          </div>
          <%}%> 
   </div>
   </div>

</body>




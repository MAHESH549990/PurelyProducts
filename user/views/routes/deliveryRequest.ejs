
<%- layout("/boilerplate/userBoiler.ejs") %>

<style>
  #applyDeliveryPage {
    --brand-green: #198754;
    --brand-dark: #14532d;
  }

  #applyDeliveryPage .form-wrapper {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  #applyDeliveryPage .partner-card {
    border: 0;
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 12px 40px rgba(0, 0, 0, .07);
  }

  #applyDeliveryPage .partner-banner {
    height: 100%;
    background: linear-gradient(145deg, #14532d, #198754);
    color: white;
    padding: 36px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #applyDeliveryPage .brand-icon {
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 17px;
    background: rgba(255, 255, 255, .16);
    font-size: 1.7rem;
    margin-bottom: 22px;
  }

  #applyDeliveryPage .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 22px;
  }

  #applyDeliveryPage .feature-icon {
    width: 36px;
    height: 36px;
    min-width: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(255, 255, 255, .15);
  }

  #applyDeliveryPage .form-panel {
    padding: 34px;
  }

  #applyDeliveryPage .form-control,
  #applyDeliveryPage .form-select {
    min-height: 46px;
    border-radius: 10px;
    border-color: #dee2e6;
    box-shadow: none;
  }

  #applyDeliveryPage textarea.form-control {
    min-height: 100px;
  }

  #applyDeliveryPage .form-control:focus,
  #applyDeliveryPage .form-select:focus {
    border-color: #198754;
    box-shadow: 0 0 0 .2rem rgba(25, 135, 84, .12);
  }

  #applyDeliveryPage .input-group-text {
    border-radius: 10px 0 0 10px;
    background: #f8faf9;
    color: #198754;
    border-color: #dee2e6;
  }

  #applyDeliveryPage .input-group .form-control {
    border-radius: 0 10px 10px 0;
  }

  #applyDeliveryPage .section-heading {
    font-size: .9rem;
    font-weight: 700;
    color: #198754;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: 18px;
  }

  #applyDeliveryPage .submit-btn {
    min-height: 49px;
    border-radius: 11px;
    font-weight: 600;
  }

  #applyDeliveryPage .form-note {
    background: #f0f9f4;
    border: 1px solid #d5eddf;
    border-radius: 11px;
    padding: 12px 14px;
  }

  #applyDeliveryPage .file-note {
    font-size: .82rem;
    margin-top: 8px;
    color: #6c757d;
  }

  @media (max-width: 767.98px) {
    #applyDeliveryPage .partner-banner {
      padding: 28px 24px;
    }

    #applyDeliveryPage .form-panel {
      padding: 25px 20px;
    }
  }

  @media (max-width: 575.98px) {
    #applyDeliveryPage .partner-banner {
      padding: 24px 20px;
    }
  }
</style>

<div id="applyDeliveryPage" class="container-fluid py-4 px-3 px-md-4">

  <!-- Page heading -->
  <div class="form-wrapper mb-4">
    <h2 class="fw-bold mb-2">Become a Delivery Partner</h2>
    <p class="text-secondary mb-0">
      Join PurelyProducts and help us deliver orders to our customers.
    </p>
  </div>

  <div class="form-wrapper">
    <div class="card partner-card">
      <div class="row g-0">

        <!-- Left information panel -->
        <div class="col-12 col-md-5">
          <div class="partner-banner">

            <div class="brand-icon">
              <i class="fa-solid fa-truck-fast"></i>
            </div>

            <h3 class="fw-bold mb-3">PurelyProducts</h3>

            <h4 class="fw-semibold mb-3">Deliver With Us</h4>

            <p class="text-white-50 mb-2">
              Apply to join our delivery team and help customers
              receive their orders safely and on time.
            </p>

            <div class="feature-item">
              <div class="feature-icon">
                <i class="fa-solid fa-user-check"></i>
              </div>
              <div>
                <div class="fw-semibold">Simple Application</div>
                <small class="text-white-50">
                  Submit your contact and experience details.
                </small>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon">
                <i class="fa-solid fa-motorcycle"></i>
              </div>
              <div>
                <div class="fw-semibold">Delivery Opportunities</div>
                <small class="text-white-50">
                  Share your vehicle and licence information.
                </small>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon">
                <i class="fa-solid fa-file-shield"></i>
              </div>
              <div>
                <div class="fw-semibold">Secure Document Review</div>
                <small class="text-white-50">
                  Submit your licence document for admin verification.
                </small>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon">
                <i class="fa-solid fa-clipboard-check"></i>
              </div>
              <div>
                <div class="fw-semibold">Admin Review</div>
                <small class="text-white-50">
                  Your application will be reviewed by our admin.
                </small>
              </div>
            </div>

          </div>
        </div>

        <!-- Right application form -->
        <div class="col-12 col-md-7">
          <div class="form-panel">

            <div class="mb-4">
              <h4 class="fw-bold mb-2">Delivery Partner Application</h4>
              <p class="text-secondary small mb-0">
                Fill in your details to apply. Your existing customer
                account will remain unchanged until your application is approved.
              </p>
            </div>

            <form action="/users/delivery/apply"
                  method="POST"
                  enctype="multipart/form-data"
                  autocomplete="on">

              <!-- Contact details -->
              <div class="section-heading">
                <i class="fa-solid fa-address-card me-2"></i>
                Contact Details
              </div>

              <div class="row g-3 mb-4">

                <div class="col-12 col-sm-6">
                  <label for="phone" class="form-label fw-semibold">
                    Phone Number <span class="text-danger">*</span>
                  </label>

                  <div class="input-group">
                    <span class="input-group-text">
                      <i class="fa-solid fa-phone"></i>
                    </span>
                    <input type="tel"
                           class="form-control"
                           id="phone"
                           name="phone"
                           placeholder="Enter phone number"
                           autocomplete="tel"
                           required>
                  </div>
                </div>

                <div class="col-12 col-sm-6">
                  <label for="experience" class="form-label fw-semibold">
                    Delivery Experience
                  </label>

                  <select class="form-select form-control"
                          id="experience"
                          name="experience"
                          required>
                    <option value="" selected disabled>
                      Select experience
                    </option>
                    <option value="Fresher">Fresher</option>
                    <option value="Less than 1 year">Less than 1 year</option>
                    <option value="1-3 years">1–3 years</option>
                    <option value="3+ years">3+ years</option>
                  </select>
                </div>

                <div class="col-12">
                  <label for="address" class="form-label fw-semibold">
                    Residential Address <span class="text-danger">*</span>
                  </label>

                  <div class="input-group">
                    <span class="input-group-text">
                      <i class="fa-solid fa-location-dot"></i>
                    </span>
                    <textarea class="form-control"
                              id="address"
                              name="address"
                              rows="3"
                              placeholder="House number, street, city, state and PIN code"
                              autocomplete="street-address"
                              required></textarea>
                  </div>
                </div>

              </div>

              <!-- Vehicle details -->
              <div class="section-heading">
                <i class="fa-solid fa-truck me-2"></i>
                Vehicle Details
              </div>

              <div class="row g-3 mb-4">

                <div class="col-12 col-sm-6">
                  <label for="vehicleNumber" class="form-label fw-semibold">
                    Vehicle Number <span class="text-danger">*</span>
                  </label>

                  <div class="input-group">
                    <span class="input-group-text">
                      <i class="fa-solid fa-motorcycle"></i>
                    </span>
                    <input type="text"
                           class="form-control text-uppercase"
                           id="vehicleNumber"
                           name="vehicleNumber"
                           placeholder="e.g. UK01AB1234"
                           required>
                  </div>
                </div>

                <div class="col-12 col-sm-6">
                  <label for="licenseNumber" class="form-label fw-semibold">
                    Driving Licence Number <span class="text-danger">*</span>
                  </label>

                  <div class="input-group">
                    <span class="input-group-text">
                      <i class="fa-solid fa-id-card"></i>
                    </span>
                    <input type="text"
                           class="form-control text-uppercase"
                           id="licenseNumber"
                           name="licenseNumber"
                           placeholder="Enter licence number"
                           required>
                  </div>
                </div>

                <!-- NEW: Driving licence image or PDF -->
                <div class="col-12">
                  <label for="licenseImage" class="form-label fw-semibold">
                    Driving Licence Image / File
                    <span class="text-danger">*</span>
                  </label>

                  <div class="input-group">
                    <span class="input-group-text">
                      <i class="fa-solid fa-file-arrow-up"></i>
                    </span>

                    <input type="file"
                           class="form-control"
                           id="licenseImage"
                           name="licenseImage"
                           accept=".jpg,.jpeg,.png,.webp,.pdf"
                           required>
                  </div>

                  <div class="file-note">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Accepted formats: JPG, JPEG, PNG, WEBP, PDF. Maximum size: 5 MB.
                  </div>
                </div>

              </div>

              <!-- Review information -->
              <div class="form-note mb-4">
                <div class="d-flex gap-2">
                  <i class="fa-solid fa-circle-info text-success mt-1"></i>
                  <div class="small text-secondary">
                    Submitting this form does not guarantee approval.
                    The admin will review your application. Do not submit
                    passwords or payment information in this form.
                    Your licence document should be stored securely and
                    accessible only to authorised reviewers.
                  </div>
                </div>
              </div>

              <button type="submit"
                      class="btn btn-success submit-btn w-100">
                <i class="fa-solid fa-paper-plane me-2"></i>
                Submit Application
              </button>

              <div class="text-center mt-3">
                <a href="/users/profile"
                   class="text-secondary text-decoration-none small">
                  <i class="fa-solid fa-arrow-left me-1"></i>
                  Back to My Profile
                </a>
              </div>

            </form>

          </div>
        </div>

      </div>
    </div>

    <!-- Footer -->
    <div class="text-center text-secondary small mt-4">
      <i class="fa-solid fa-shield-halved me-1"></i>
      PurelyProducts Customer Portal
    </div>
  </div>
</div>

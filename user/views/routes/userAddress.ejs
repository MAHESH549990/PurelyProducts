const stateSelect = document.getElementById("state");
const citySelect = document.getElementById("city");


stateSelect.addEventListener("change", function () {

    const selectedState = this.value;

    // Clear old cities
    citySelect.innerHTML =
        '<option value="">Select City</option>';

    // If no state selected
    if (!selectedState) {
        return;
    }

    // Get cities of selected state
    const stateCities = cities[selectedState];

    // Add cities to dropdown
    stateCities.forEach(function (city) {

        const option = document.createElement("option");

        option.value = city;
        option.textContent = city;

        citySelect.appendChild(option);

    });

});

</script>
       <button class="btn btn-outline-primary my-4 text-black btn-lg" type="submit">Add Address</button>
    </form>
</div>
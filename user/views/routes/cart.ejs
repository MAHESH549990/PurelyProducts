<%-layout("/boilerplate/boilerplate")%>
<body>
   <div class="row">
    <%for(let item of allItems){%>
    <div class="col-lg-6 col-md-10 col-sm-12">
    <div class="card card-for-cart">
       <img src="<%=item.image.url%>" class="card-img-top">
       <div class="card-body p-3">
        <p class="card-title"><b><%=item.name%></b><br/>&#8377; <%=item.price.toLocaleString("en-IN") %></p>
        <p class="card-text h5">
          <%=item.description%>
        </p>
     <% for(let i = 1; i <= item.rating; i++) { %>
      <i class="fa-solid fa-star text-warning"></i>
     <% } %>
     <span><%= item.rating %>/5</span>
     <div class="mt-3">
    <button type="button" class="btn btn-outline-success">Place Order</button>
    <button type="button" class="btn btn-outline-danger">Delete</button>
    </div>
  </div>
  </div>
  </div>
  <% } %>
  </div>
  </div>
    <div class="container-fluid">
    <div class="h1 mt-5 bg-white rounded-3 p-3">
    <p>Total Item: <%=allItems.length%></p>
    <p>Total Price: <%=price%></p>
    <button class="btn btn-success">Place all orders</button>
  </div>
</body>

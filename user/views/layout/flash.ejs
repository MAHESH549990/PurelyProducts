<%if(success && success.length){%>
<div class="alert alert-success alert-dismissible fade show" role="alert" style="display: flex !important; justify-content: center !important; align-items: center !important;">
<h6><%=success%></h6>
 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>

<%if(error && error.length){%>
<div class="alert alert-danger alert-dismissible fade show" role="alert" style="display: flex !important; justify-content: center !important; align-items: center !important;">
<h6><%=error%></h6>
 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
   <link rel="stylesheet" href="/login.css">
    <link rel="icon" href="/images/Website_logo.png">
</head>
<body>
  <br>
  <%- include("../layout/flash.ejs") %>
  <form action="/users/login" method="post" class="mt-3 needs-validation" novalidate>
    <div class="container-fluid bg-white">
    <div class="row flex-class">
            <!--image-->
      <div class="col-lg-6 col-md-8 col-sm-12">
        <img src="/images/login-side-img.png" style="height:70%;width:94%" class="image">
      </div>
      <div class="col-lg-5 col-md-8 col-sm-12">
        <div class="card border-0 text-center">
        <div class="card-title mb-4 mt-5"><i class="fa-brands fa-shopware"></i>PurelyProducts</div>
          <h2 class="mb-5">Welcome back!</h2>
        </div>
      <div class="mb-4">
        <label class="form-label" for="name"><i class="fa-solid fa-address-card"></i> Name: </label>
        <input type="text" placeholder="Rakesh Joshi" id="name" class="form-control" name="username" required>
        <div class="valid-feedback">
          Name look's good
        </div>
        <div class="invalid-feedback">
          Please enter name
        </div>
      </div>
      <div class="mb-5">
        <label class="form-label" for="password"><i class="fa-solid fa-lock"></i> Password: </label>
        <input type="password" placeholder="" id="password" class="form-control" name="password" required>
        <div class="valid-feedback">
          Password look's good
        </div>
        <div class="invalid-feedback">
          Please enter password
        </div>
      </div>

      <div class="d-flex justify-content-between">
      <div class="mb-5">
          <button class="btn btn-outline-success mb-4">Login</button>
      </div>
      <div>
         <a href="/users/updatePassword" class="a-tag">Forget password?</a>
      </div>
      </div>
      </div>
      </div>
      </div>
  </form>
  <script src="/validation.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
<%- layout("/boilerplate/adminBoiler.ejs") %>

<div class="container-fluid py-4 px-3 px-md-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fa-solid fa-fire text-danger me-2"></i>
                Top Products
            </h2>
            <p class="text-secondary mb-0">
                Explore your store's featured products and customer ratings.
            </p>
        </div>

        <div class="bg-white border shadow-sm rounded-4 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-warning-subtle text-warning rounded-3 p-3">
                    <i class="fa-solid fa-boxes-stacked fa-xl"></i>
                </div>
                <div>
                    <p class="text-secondary small mb-1">Products Listed</p>
                    <h4 class="fw-bold mb-0"><%= products.length %></h4>
                </div>
            </div>
        </div>
    </div>

    <hr class="text-secondary opacity-25 mb-4">

    <!-- Products Grid -->
    <% if (!products || products.length === 0) { %>

        <div class="bg-white rounded-4 shadow-sm text-center p-5">
            <i class="fa-solid fa-box-open fa-3x text-secondary mb-3"></i>
            <h4 class="fw-bold">No Products Found</h4>
            <p class="text-secondary mb-0">
                Products will appear here when they are available.
            </p>
        </div>

    <% } else { %>

        <div class="row g-4">

            <% for (let product of products) { %>

                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                       <!-- Product Image -->
                      <div class="bg-light p-3">
                          <div class="rounded-4 overflow-hidden border bg-white">
                              <img
                                  src="<%= product.image.url %>"
                                  alt="<%= product.name %>"
                                  class="w-100 d-block rounded-4"
                                  style="height: 240px; object-fit: contain;"
                              >
                          </div>
                      </div>

                        <!-- Product Information -->
                        <div class="card-body p-4 d-flex flex-column">

                            <h5 class="fw-bold mb-2">
                                <%= product.name %>
                            </h5>

                            <h4 class="fw-bold text-success mb-3">
                                &#8377;<%= product.price.toLocaleString("en-IN") %>
                            </h4>

                            <p class="text-secondary mb-3">
                                <%= product.description %>
                            </p>

                            <!-- Rating -->
                            <div class="mt-auto pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <div class="text-warning">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="fa-<%= i <= product.rating ? 'solid' : 'regular' %> fa-star"></i>
                                        <% } %>
                                    </div>

                                    <span class="badge text-bg-warning rounded-pill">
                                        <i class="fa-solid fa-star me-1"></i>
                                        <%= product.rating %>/5
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

            <% } %>

        </div>

    <% } %>

</div>
<%-layout("/boilerplate/boiler.ejs")%>
<div class="container-fluid">
  <div class="bg-white row my-4 rounded-3 p-1">
  <div class="col-lg-6 col-md-6 col-sm-12">
        <a href="/admin/products/new"><button class="btn btn-outline-dark btn-lg p-3 my-3"><i class="fa-solid fa-square-plus"></i> Add New Product</button></a>
  </div>
  <div class="col-lg-6 col-md-6 col-sm-12 mt-4">
       <h4>Total Products: <%=totalProducts%></h4>
  </div>
  </div>
  <class class="row">
    <%for(let product of products){%>
         <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card">
            <a href="/admin/products/<%=product._id%>" class="item-link">
            <div class="container-fluid card p-3">
            <img src="<%=product.image.url%>" class="card-img-top" alt="Product_images">
            <div class="card-body">
              <p class="card-text"><b><%=product.name%></b><br/>&#8377; <%=product.price.toLocaleString("en-IN") %></p>
              <% for(let i = 1; i <= product.rating; i++) { %>
                <i class="fa-solid fa-star text-warning"></i>
              <% } %>
              <span><%= product.rating %>/5</span>
            </div>
            </div>
            </div>
            </a>
            </div>
    <%}%>
  </class>
</div>
<%- layout("/boilerplate/adminBoiler.ejs") %>

<div class="container py-5">

  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1">
        <i class="fa-solid fa-box-open text-primary me-2"></i>
        Pending Orders
      </h2>
      <p class="text-secondary mb-0">
        Manage and confirm customer orders.
      </p>
    </div>

    <span class="badge text-bg-warning fs-6 px-3 py-2">
      <%= orders.length %> Pending
    </span>
  </div>

  <% if (orders.length === 0) { %>

    <!-- Empty State -->
    <div class="card border-0 shadow-sm text-center py-5">
      <div class="card-body">
        <i class="fa-solid fa-clipboard-check fa-3x text-secondary mb-3"></i>
        <h4 class="fw-bold">No Pending Orders</h4>
        <p class="text-secondary mb-0">
          All caught up! New orders will appear here.
        </p>
      </div>
    </div>

  <% } else { %>

    <div class="row g-4">

      <% for (let order of orders) { %>

        <div class="col-12">
          <div class="card border-0 shadow-sm rounded-4">

            <!-- Order Header -->
            <div class="card-header bg-light border-0 p-3 p-md-4 rounded-top-4">
              <div class="row align-items-center g-3">

                <div class="col-12 col-md-5">
                  <div class="text-secondary small mb-1">ORDER ID</div>
                  <div class="fw-bold text-break">
                    #<%= order._id %>
                  </div>
                </div>

                <div class="col-7 col-md-4">
                  <div class="text-secondary small mb-1">ORDER DATE</div>
                  <div class="fw-semibold">
                    <%= new Date(order.createdAt).toLocaleDateString("en-IN", {
                      day: "2-digit",
                      month: "short",
                      year: "numeric"
                    }) %>
                  </div>
                </div>

                <div class="col-5 col-md-3 text-md-end">
                  <span class="badge text-bg-warning px-3 py-2">
                    <i class="fa-regular fa-clock me-1"></i>
                    <%= order.status %>
                  </span>
                </div>

              </div>
            </div>

            <!-- Order Body -->
            <div class="card-body p-3 p-md-4">

              <!-- Customer -->
              <h6 class="fw-bold mb-3">
                <i class="fa-solid fa-user text-primary me-2"></i>
                Customer Details
              </h6>

              <div class="bg-light rounded-3 p-3 mb-4">
                <% if (order.customer) { %>

                  <div class="fw-semibold">
                    <%= order.customer.username || order.customer.name || "Customer" %>
                  </div>

                  <div class="text-secondary small">
                    <%= order.customer.email || "Email unavailable" %>
                  </div>

                <% } else { %>

                  <span class="text-danger">Customer details unavailable</span>

                <% } %>
              </div>

              <!-- Products -->
              <h6 class="fw-bold mb-3">
                <i class="fa-solid fa-bag-shopping text-primary me-2"></i>
                Ordered Products
              </h6>

              <div class="table-responsive mb-4">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Product</th>
                      <th>Product ID</th>
                      <th class="text-center">Quantity</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% for (let item of order.products) { %>

                      <tr>
                        <td class="fw-semibold">
                          <%= item.product
                            ? (item.product.title || item.product.name || "Product")
                            : "Product unavailable" %>
                        </td>

                        <td class="small text-secondary text-break">
                          <%= item.product ? item.product._id : "N/A" %>
                        </td>

                        <td class="text-center">
                          <span class="badge text-bg-secondary rounded-pill px-3 py-2">
                            <%= item.quantity %>
                          </span>
                        </td>
                      </tr>

                    <% } %>
                  </tbody>
                </table>
              </div>

              <!-- Total and Action -->
              <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 border-top pt-4">

                <div>
                  <div class="text-secondary small mb-1">TOTAL AMOUNT</div>
                  <h3 class="fw-bold text-success mb-0">
                    ₹<%= Number(order.totalAmount || 0).toLocaleString("en-IN") %>
                  </h3>
                </div>

                <% if (order.status === "placed") { %>

                  <form
                    action="/admin/users/orders/confirmed/<%= order._id %>/accept?_method=PATCH"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to accept this order?');"
                  >
                    <button type="submit" class="btn btn-success btn-lg">
                      <i class="fa-solid fa-check me-2"></i>
                      Accept Order
                    </button>
                  </form>

                <% } %>

              </div>

            </div>
          </div>
        </div>

      <% } %>

    </div>

  <% } %>

</div>
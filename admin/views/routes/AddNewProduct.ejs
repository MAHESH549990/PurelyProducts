
<%- layout("/boilerplate/adminBoiler.ejs") %>

<div class="container-fluid py-4">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">

            <!-- Page Heading -->
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-2">
                    <i class="fa-solid fa-box-open text-success me-2"></i>
                    Add New Product
                </h2>
                <p class="text-secondary mb-0">
                    Add a new product to your store by entering the details below.
                </p>
            </div>

            <!-- Form Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-header bg-success text-white py-3 px-4">
                    <h5 class="mb-0 fw-semibold">
                        <i class="fa-solid fa-file-circle-plus me-2"></i>
                        Product Information
                    </h5>
                </div>

                <div class="card-body p-4 p-md-5">

                    <form action="/admin/products/new"
                          method="post"
                          class="needs-validation"
                          novalidate>

                        <!-- Name -->
                        <div class="mb-4">
                            <label for="name" class="form-label fw-semibold">
                                <i class="fa-solid fa-file-signature me-2 text-secondary"></i>
                                Product Name
                            </label>
                            <input
                                type="text"
                                class="form-control"
                                id="name"
                                name="name"
                                placeholder="e.g. Spiral Notebook"
                                required
                            >
                            <div class="valid-feedback">
                                Product name looks good!
                            </div>
                            <div class="invalid-feedback">
                                Please enter the product name.
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold">
                                <i class="fa-brands fa-readme me-2 text-secondary"></i>
                                Description
                            </label>
                            <textarea
                                class="form-control"
                                id="description"
                                name="description"
                                rows="4"
                                placeholder="Describe your product..."
                                required
                            ></textarea>
                            <div class="valid-feedback">
                                Product description looks good!
                            </div>
                            <div class="invalid-feedback">
                                Please enter the product description.
                            </div>
                        </div>

                        <!-- Image URL -->
                        <div class="mb-4">
                            <label for="image" class="form-label fw-semibold">
                                <i class="fa-solid fa-image me-2 text-secondary"></i>
                                Product Image URL
                            </label>
                            <input
                                type="url"
                                class="form-control"
                                id="image"
                                name="image[url]"
                                placeholder="https://example.com/image.jpg"
                                required
                            >
                            <div class="valid-feedback">
                                Product image URL looks good!
                            </div>
                            <div class="invalid-feedback">
                                Please enter a valid product image URL.
                            </div>
                        </div>

                        <!-- Price and Rating -->
                        <div class="row g-4">

                            <div class="col-12 col-md-6">
                                <label for="price" class="form-label fw-semibold">
                                    <i class="fa-solid fa-indian-rupee-sign me-2 text-secondary"></i>
                                    Price
                                </label>
                                <input
                                    type="number"
                                    class="form-control"
                                    id="price"
                                    name="price"
                                    min="0"
                                    step="0.01"
                                    placeholder="999"
                                    required
                                >
                                <div class="valid-feedback">
                                    Product price looks good!
                                </div>
                                <div class="invalid-feedback">
                                    Please enter a valid product price.
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="rating" class="form-label fw-semibold">
                                    <i class="fa-regular fa-star me-2 text-secondary"></i>
                                    Rating (1–5)
                                </label>
                                <input
                                    type="number"
                                    class="form-control"
                                    id="rating"
                                    name="rating"
                                    min="1"
                                    max="5"
                                    step="1"
                                    placeholder="e.g. 4"
                                    required
                                >
                                <div class="valid-feedback">
                                    Product rating looks good!
                                </div>
                                <div class="invalid-feedback">
                                    Please enter a rating between 1 and 5.
                                </div>
                            </div>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-5 pt-4 border-top">

                            <a href="/admin/products"
                               class="btn btn-outline-secondary px-4">
                                <i class="fa-solid fa-arrow-left me-2"></i>
                                Back to Products
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                <i class="fa-solid fa-plus me-2"></i>
                                Add Product
                            </button>

                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

<script>
    (() => {
        'use strict';

        document.querySelectorAll('.needs-validation').forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                form.classList.add('was-validated');
            });
        });
    })();
</script>

<%- layout("/boilerplate/adminBoiler.ejs") %>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Approved Delivery Partners</h2>
            <p class="text-secondary mb-0">Manage your approved delivery team.</p>
        </div>

        <a href="/admin" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Back
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="p-3">No.</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Vehicle Number</th>
                        <th>Experience</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (deliveries.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                No approved delivery partners found.
                            </td>
                        </tr>
                    <% } else { %>
                        <% deliveries.forEach((delivery, index) => { %>
                            <tr>
                                <td class="p-3"><%= index + 1 %></td>
                                <td class="fw-semibold">
                                    <%= delivery.user?.username || "N/A" %>
                                </td>
                                <td><%= delivery.user?.email || "N/A" %></td>
                                <td><%= delivery.phone || "N/A" %></td>
                                <td><%= delivery.vehicleNumber || "N/A" %></td>
                                <td><%= delivery.experience || "N/A" %></td>
                                <td class="text-center">
                                    <a href="/admin/delivery/approved/<%= delivery._id %>"
                                       class="btn btn-sm btn-outline-success">
                                        <i class="fa-solid fa-eye me-1"></i>
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
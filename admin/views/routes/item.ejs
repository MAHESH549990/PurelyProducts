<%-layout("/boilerplate/boiler.ejs")%>
 <div class="bg-white p-2 rounded-3 w-100 h-100"  id="row-for-image">
    <div class="row">
    <div class="col-lg-6 col-md-6 col-sm-12">
    <img src="<%=item.image.url%>" class="w-100 rounded-3">
    </div>
    <!-- <div class="card-img-overlay"></div> -->
    <div class="card-body-item col-lg-6 col-md-6 col-sm-12 mt-5">
    <p class="card-text h3"><b><%=item.name%></b><br/>&#8377; <%=item.price.toLocaleString("en-IN") %></p>
    <p class="card-text h5">
      <%=item.description%>
    </p>
    <div class="h3">
     <% for(let i = 1; i <= item.rating; i++) { %>
      <i class="fa-solid fa-star text-warning"></i>
     <% } %>
     <span><%= item.rating %>/5</span>
    </div>
      <div class="d-flex flex-wrap mt-4">
      <form action="/admin/products/<%=item._id%>?_method=DELETE" method="post" onclick="return confirm('Are you sure to delete this product ?');">
      <button class="btn btn-outline-danger me-4"><i class="fa-solid fa-trash-can"></i> Delete</button>
      </form>
      <form method="get" action="<%=item._id%>/update">
      <button class="btn btn-outline-primary"><i class="fa-solid fa-code-compare"></i> Update</button>
      </form>
    </div>
  </div>
  </div>
  </div>

   <div class="bg-white mt-5 mb-3 w-100 h-100 rounded-3 p-2">
    <div class="row">
    <h1 class="mt-3 mb-5"><i class="fa-solid fa-star-half"></i>Reviews</h1>
    <div class="col-lg-6 col-md-6 col-sm-12 rounded-3 mt-2">
      <h4>@Mahesh Bhatt</h4>
      <p>Nice hoodie</p>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-12 rounded-3 mt-2">
      <h4>@Mahesh Bhatt</h4>
      <p>Nice hoodie</p>
    </div>
   </div>
   </div>

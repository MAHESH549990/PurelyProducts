<%- layout("/boilerplate/adminBoiler.ejs") %>

<div class="container-fluid py-4 px-3 px-md-4">

    <!-- Header -->
    <div class="rounded-4 p-4 p-md-5 mb-4 text-white shadow-sm"
         style="background: linear-gradient(135deg, #14532d, #198754);">
        <span class="badge rounded-pill px-3 py-2 mb-3"
              style="background: rgba(255,255,255,0.16);">
            <i class="fa-solid fa-box-open me-2"></i>Product Management
        </span>
        <h2 class="fw-bold mb-2">Product Details</h2>
        <p class="text-white-50 mb-0">
            View product information and manage customer feedback.
        </p>
    </div>

    <!-- Product Details -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="row g-0">

            <!-- Product Image -->
            <div class="col-lg-5 bg-light d-flex align-items-center justify-content-center p-4">
                <div class="bg-white rounded-4 border p-3 w-100 text-center">
                    <img src="<%= item.image.url %>"
                         alt="<%= item.name %>"
                         class="img-fluid rounded-3"
                         style="width: 100%; max-height: 350px; object-fit: contain;">
                </div>
            </div>

            <!-- Product Information -->
            <div class="col-lg-7">
                <div class="card-body p-4 p-md-5">

                    <p class="text-success small fw-semibold mb-2">
                        PURELYPRODUCTS / PRODUCT OVERVIEW
                    </p>

                    <h2 class="fw-bold mb-3" style="overflow-wrap: anywhere;">
                        <%= item.name %>
                    </h2>

                    <h3 class="text-success fw-bold mb-3">
                        ₹<%= item.price.toLocaleString("en-IN") %>
                    </h3>

                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="text-warning">
                            <% for (let i = 1; i <= 5; i++) { %>
                                <% if (i <= item.rating) { %>
                                    <i class="fa-solid fa-star"></i>
                                <% } else { %>
                                    <i class="fa-regular fa-star"></i>
                                <% } %>
                            <% } %>
                        </div>
                        <span class="fw-semibold"><%= item.rating %>/5</span>
                    </div>

                    <hr>

                    <h5 class="fw-bold mb-3">
                        <i class="fa-solid fa-align-left text-success me-2"></i>
                        Description
                    </h5>

                    <p class="text-secondary lh-lg mb-4"
                       style="white-space: pre-line; overflow-wrap: anywhere;"><%= item.description %></p>

                    <div class="d-flex flex-column flex-sm-row gap-3 mt-4">

                        <a href="/admin/products/<%= item._id %>/update"
                           class="btn btn-success rounded-3 fw-semibold px-4">
                            <i class="fa-solid fa-pen-to-square me-2"></i>
                            Update Product
                        </a>

                        <form action="/admin/products/<%= item._id %>?_method=DELETE"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this product?');">

                            <button type="submit"
                                    class="btn btn-outline-danger rounded-3 fw-semibold px-4 w-100">
                                <i class="fa-solid fa-trash-can me-2"></i>
                                Delete Product
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Reviews Heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-star-half-stroke text-success me-2"></i>
                Customer Reviews
            </h3>
            <p class="text-secondary mb-0">
                Review and moderate feedback submitted by customers.
            </p>
        </div>

        <span class="badge rounded-pill text-bg-success px-3 py-2 fs-6">
            <i class="fa-solid fa-comments me-2"></i>
            <%= item.reviews.length %> Reviews
        </span>
    </div>

    <!-- Reviews List -->
    <% if (item.reviews.length === 0) { %>

        <div class="bg-white rounded-4 shadow-sm p-5 text-center">
            <i class="fa-regular fa-comment-dots fs-1 text-secondary mb-3"></i>
            <h5 class="fw-bold">No Reviews Yet</h5>
            <p class="text-secondary mb-0">
                Customer reviews for this product will appear here.
            </p>
        </div>

    <% } else { %>

        <div class="row g-4">

            <% for (let review of item.reviews) { %>

                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">

                            <!-- Reviewer and Rating -->
                            <div class="d-flex align-items-center gap-3 mb-3">

                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                                     style="width: 48px; height: 48px; min-width: 48px; background: #198754;">
                                    <i class="fa-solid fa-user fs-5"></i>
                                </div>

                                <div>
                                    <h6 class="fw-bold mb-1">
                                        <%= review.owner ? review.owner.username : "Unknown Customer" %>
                                    </h6>

                                    <div class="text-warning small">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <% if (i <= review.rating) { %>
                                                <i class="fa-solid fa-star"></i>
                                            <% } else { %>
                                                <i class="fa-regular fa-star"></i>
                                            <% } %>
                                        <% } %>

                                        <span class="text-secondary ms-1">
                                            <%= review.rating %>/5
                                        </span>
                                    </div>
                                </div>

                            </div>

                            <!-- Review Comment -->
                            <p class="text-secondary lh-lg"
                               style="white-space: pre-line; overflow-wrap: anywhere;"><%= review.comment %></p>

                            <!-- Review Image -->
                            <% if (review.image && review.image.url) { %>
                                <img src="<%= review.image.url %>"
                                     alt="Customer review image"
                                     loading="lazy"
                                     class="img-fluid rounded-3 mb-3"
                                     style="width: 100%; max-height: 250px; object-fit: contain; background: #f8f9fa;">
                            <% } %>
                        </div>
                    </div>
                </div>

            <% } %>

        </div>

    <% } %>

</div>
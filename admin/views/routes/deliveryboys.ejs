<%- layout("/boilerplate/adminBoiler.ejs") %>

<style>
  #deliveryOperationsPage {
    --brand-green: #198754;
    --brand-dark: #14532d;
  }

  #deliveryOperationsPage .page-header {
    background: linear-gradient(120deg, #14532d, #198754);
    color: #fff;
    border-radius: 18px;
    padding: 32px;
    margin-bottom: 28px;
  }

  #deliveryOperationsPage .operation-card {
    background: #fff;
    border: 1px solid #edf0ee;
    border-radius: 18px;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #deliveryOperationsPage .operation-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.07);
  }

  #deliveryOperationsPage .operation-icon {
    width: 54px;
    height: 54px;
    min-width: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    background: #e8f5ed;
    color: #198754;
    font-size: 1.4rem;
  }

  #deliveryOperationsPage .operation-description {
    color: #6c757d;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  #deliveryOperationsPage .operation-link {
    min-height: 44px;
    border-radius: 10px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #deliveryOperationsPage .info-panel {
    background: #f0f9f4;
    border: 1px solid #d5eddf;
    border-radius: 14px;
    padding: 18px 20px;
  }

  @media (max-width: 575.98px) {
    #deliveryOperationsPage .page-header {
      padding: 24px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #deliveryOperationsPage .operation-card {
      transition: none;
    }

    #deliveryOperationsPage .operation-card:hover {
      transform: none;
    }
  }
</style>

<div id="deliveryOperationsPage" class="container-fluid py-4 px-3 px-md-4">

  <!-- Page Heading -->
  <div class="page-header">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">

      <div>
        <div class="small text-white-50 fw-semibold mb-2">
          PURELYPRODUCTS ADMIN PANEL
        </div>

        <h2 class="fw-bold mb-3">
          <i class="fa-solid fa-truck-fast me-2"></i>
          Delivery Operations
        </h2>

        <p class="text-white-50 mb-0">
          Manage delivery partner applications, approved accounts and order assignments.
        </p>
      </div>

      <div class="d-none d-sm-flex align-items-center justify-content-center rounded-4"
           style="width: 76px; height: 76px; background: rgba(255,255,255,0.14);">
        <i class="fa-solid fa-boxes-stacked fa-2x"></i>
      </div>

    </div>
  </div>

  <!-- Section Heading -->
  <div class="mb-4">
    <h4 class="fw-bold mb-2">Delivery Management</h4>
    <p class="text-secondary mb-0">
      Choose an operation to manage your delivery team and orders.
    </p>
  </div>

  <!-- Operation Cards -->
  <div class="row g-4">

    <!-- Pending Delivery Requests -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="operation-card p-4 d-flex flex-column">

        <div class="operation-icon mb-4">
          <i class="fa-solid fa-clock"></i>
        </div>

        <h5 class="fw-bold mb-3">Delivery Requests</h5>

        <p class="operation-description mb-4">
          Review new applications, check applicant information and approve or reject requests.
        </p>

        <a href="/admin/delivery-requests/requests"
           class="btn btn-outline-success operation-link w-100 mt-auto">
          <i class="fa-solid fa-clipboard-check me-2"></i>
          Review Requests
        </a>

      </div>
    </div>

    <!-- All Applications -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="operation-card p-4 d-flex flex-column">

        <div class="operation-icon mb-4">
          <i class="fa-solid fa-users"></i>
        </div>

        <h5 class="fw-bold mb-3">All Applications</h5>

        <p class="operation-description mb-4">
          View delivery partner applications and check their current approval status.
        </p>

        <a href="/admin/delivery-requests/applications"
           class="btn btn-outline-success operation-link w-100 mt-auto">
          <i class="fa-solid fa-eye me-2"></i>
          View Applications
        </a>

      </div>
    </div>

    <!-- Approved Delivery Partners -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="operation-card p-4 d-flex flex-column">

        <div class="operation-icon mb-4">
          <i class="fa-solid fa-circle-check"></i>
        </div>

        <h5 class="fw-bold mb-3">Approved Partners</h5>

        <p class="operation-description mb-4">
          Access approved delivery partner details, including their contact and vehicle information.
        </p>

        <a href="/admin/delivery-requests/approved"
           class="btn btn-success operation-link w-100 mt-auto">
          <i class="fa-solid fa-user-check me-2"></i>
          View Approved Partners
        </a>

      </div>
    </div>

    <!-- Add Delivery Partner -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="operation-card p-4 d-flex flex-column">

        <div class="operation-icon mb-4">
          <i class="fa-solid fa-user-plus"></i>
        </div>

        <h5 class="fw-bold mb-3">Add Delivery Partner</h5>

        <p class="operation-description mb-4">
          Open the form to register a delivery partner and enter their account and vehicle information.
        </p>

        <a href="/admin/delivery/partners/new"
           class="btn btn-outline-success operation-link w-100 mt-auto">
          <i class="fa-solid fa-plus me-2"></i>
          Add New Delivery Partner
        </a>

      </div>
    </div>

    <!-- Order Assignments -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="operation-card p-4 d-flex flex-column">

        <div class="operation-icon mb-4">
          <i class="fa-solid fa-box-open"></i>
        </div>

        <h5 class="fw-bold mb-3">Order Assignments</h5>

        <p class="operation-description mb-4">
          Manage confirmed orders and assign deliveries to approved delivery partners.
        </p>

        <a href="/admin/orders/confirmed"
           class="btn btn-outline-success operation-link w-100 mt-auto">
          <i class="fa-solid fa-truck-fast me-2"></i>
          View Confirmed Orders
        </a>

      </div>
    </div>

  </div>

  <!-- Information Panel -->
  <div class="info-panel mt-4">
    <div class="d-flex align-items-start gap-3">

      <i class="fa-solid fa-circle-info text-success fs-5 mt-1"></i>

      <div>
        <h6 class="fw-bold mb-1">Delivery Workflow</h6>
        <p class="text-secondary small mb-0">
          Review applications, approve eligible partners, view their details,
          and assign confirmed customer orders when the assignment workflow is ready.
        </p>
      </div>

    </div>
  </div>

  <!-- Footer -->
  <div class="text-center text-secondary small mt-5">
    <i class="fa-solid fa-shield-halved me-1"></i>
    PurelyProducts Admin Panel
  </div>

</div>
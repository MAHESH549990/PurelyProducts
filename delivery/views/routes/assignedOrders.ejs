<%- layout("/boilerplate/deliveryBoiler") %>

<div class="container-fluid px-3 px-md-4 py-4">

    <div class="mb-4">
        <p class="text-success fw-semibold small mb-2">
            DELIVERY PARTNER / ORDERS
        </p>
        <h2 class="fw-bold mb-1">Assigned Orders</h2>
        <p class="text-secondary mb-0">
            View the orders assigned to you.
        </p>
    </div>

    <div class="mb-4">
        <span class="order-count">
            <i class="fa-solid fa-boxes-stacked me-2"></i>
            Total Orders: <%= orders.length %>
        </span>
    </div>

    <% if (orders.length === 0) { %>

        <div class="empty-orders text-center p-5">
            <div class="empty-icon mb-3">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <h4 class="fw-bold">No Assigned Orders</h4>
            <p class="text-secondary mb-0">
                You don't have any assigned orders right now.
            </p>
        </div>

    <% } else { %>

        <div class="row g-4">

            <% for (let order of orders) { %>

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card order-card h-100">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div class="order-icon">
                                    <i class="fa-solid fa-box"></i>
                                </div>

                                <span class="status-badge">
                                    <%= order.status.replaceAll("_", " ") %>
                                </span>
                            </div>

                            <p class="text-secondary small mb-1">ORDER ID</p>

                            <h6 class="fw-bold text-break mb-4">
                                #<%= order._id %>
                            </h6>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-secondary">
                                    <i class="fa-solid fa-indian-rupee-sign me-2"></i>
                                    Total Amount
                                </span>

                                <span class="fw-bold">
                                    ₹<%= Number(order.totalAmount).toLocaleString("en-IN") %>
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="text-secondary">
                                    <i class="fa-solid fa-cubes me-2"></i>
                                    Items
                                </span>

                                <span class="fw-semibold">
                                    <%= order.products ? order.products.length : (order.product ? 1 : 0) %>
                                </span>
                            </div>

                            <!-- Order Details Button -->
                            <a href="/delivery/orders/assign/<%= order._id %>"
                               class="btn btn-success w-100 rounded-3 fw-semibold">
                                <i class="fa-solid fa-eye me-2"></i>
                                Order Details
                            </a>

                        </div>
                    </div>
                </div>

            <% } %>

        </div>

    <% } %>

</div>

<style>
    .order-count {
        display: inline-block;
        background: #e8f5ec;
        color: #167344;
        padding: 12px 18px;
        border-radius: 10px;
        font-weight: 600;
    }

    .order-card {
        border: 1px solid #e2e8e3;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
    }

    .order-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #e5f5eb;
        color: #198754;
        font-size: 1.25rem;
    }

    .status-badge {
        background: #fff3d9;
        color: #986300;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: capitalize;
    }

    .empty-orders {
        background: #fff;
        border: 1px solid #e2e8e3;
        border-radius: 14px;
    }

    .empty-icon {
        font-size: 3rem;
        color: #198754;
    }
</style>
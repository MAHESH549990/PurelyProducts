
<%- layout("/boilerplate/deliveryBoiler") %>

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-success fw-semibold small mb-2">
                DELIVERY PARTNER / OVERVIEW
            </p>
            <h2 class="fw-bold mb-1">Delivery Dashboard</h2>
            <p class="text-secondary mb-0">
                Welcome back, Delivery Partner!
            </p>
        </div>

        <a href="/delivery/orders"
           class="btn btn-success px-4 py-2 rounded-3 fw-semibold">
            <i class="fa-solid fa-arrow-right me-2"></i>
            View My Deliveries
        </a>
    </div>

    <!-- Main Banner -->
    <div class="rounded-4 p-4 p-md-5 mb-4 text-white position-relative overflow-hidden"
         style="background: linear-gradient(115deg, #123b2a, #198754);">

        <div class="row align-items-center">
            <div class="col-md-8 position-relative" style="z-index: 1;">
                <span class="badge bg-white text-success rounded-pill px-3 py-2 mb-3">
                    <i class="fa-solid fa-truck-fast me-2"></i>
                    Delivery Partner Portal
                </span>

                <h1 class="fw-bold mb-3">
                    Manage your deliveries.
                </h1>

                <p class="mb-4" style="max-width: 500px; color: #e1f4e8;">
                    Manage assigned orders, update delivery statuses, and help
                    customers receive their purchases on time.
                </p>

                <a href="/delivery/orders"
                   class="btn btn-light text-success fw-semibold rounded-3 px-4 py-2">
                    Open Deliveries
                    <i class="fa-solid fa-arrow-up-right-from-square ms-2"></i>
                </a>
            </div>

            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                <i class="fa-solid fa-truck-fast"
                   style="font-size: clamp(5rem, 12vw, 9rem); opacity: 0.18;"></i>
            </div>
        </div>
    </div>

    <!-- Section Heading -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-1">Delivery Management</h5>
            <p class="text-secondary small mb-0">
                Manage your assigned and completed deliveries.
            </p>
        </div>
    </div>

    <!-- Management Cards -->
    <div class="row g-3">

        <!-- Assigned Orders -->
        <div class="col-md-6 col-xl-4">
            <a href="/delivery/orders/assign"
               class="text-decoration-none text-dark">
                <div class="card delivery-card h-100 border rounded-4">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="delivery-icon"
                                 style="background: #e8f0ff; color: #3867d6;">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </div>
                            <i class="fa-solid fa-arrow-up-right-from-square text-secondary"></i>
                        </div>

                        <h5 class="fw-bold mb-2">Assigned Orders</h5>
                        <p class="text-secondary small mb-4">
                            Check the orders assigned to you and review their details.
                        </p>

                        <span class="text-primary fw-semibold small">
                            View Assigned Orders
                            <i class="fa-solid fa-arrow-right ms-2"></i>
                        </span>

                    </div>
                </div>
            </a>
        </div>

        <!-- Out for Delivery -->
        <div class="col-md-6 col-xl-4">
            <a href="/delivery/orders/assign/out-for-delivery"
               class="text-decoration-none text-dark">
                <div class="card delivery-card h-100 border rounded-4">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="delivery-icon"
                                 style="background: #fff2df; color: #d98200;">
                                <i class="fa-solid fa-truck-fast"></i>
                            </div>
                            <i class="fa-solid fa-arrow-up-right-from-square text-secondary"></i>
                        </div>

                        <h5 class="fw-bold mb-2">Out for Delivery</h5>
                        <p class="text-secondary small mb-4">
                            Access your delivery list and update orders when they are on the way.
                        </p>

                        <span class="text-warning fw-semibold small">
                            Manage Deliveries
                            <i class="fa-solid fa-arrow-right ms-2"></i>
                        </span>

                    </div>
                </div>
            </a>
        </div>

        <!-- Completed Deliveries -->
        <div class="col-md-6 col-xl-4">
            <a href="/delivery/orders/assign/delivered"
               class="text-decoration-none text-dark">
                <div class="card delivery-card h-100 border rounded-4">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="delivery-icon"
                                 style="background: #e1f7e9; color: #198754;">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                            <i class="fa-solid fa-arrow-up-right-from-square text-secondary"></i>
                        </div>

                        <h5 class="fw-bold mb-2">Completed Deliveries</h5>
                        <p class="text-secondary small mb-4">
                            Review completed orders and keep track of your delivery work.
                        </p>

                        <span class="text-success fw-semibold small">
                            View Order History
                            <i class="fa-solid fa-arrow-right ms-2"></i>
                        </span>

                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- Workflow -->
    <div class="mt-4">
        <h5 class="fw-bold mb-3">Delivery Workflow</h5>

        <div class="card border rounded-4">
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">

                    <div class="col-6 col-lg-3">
                        <div class="workflow-step">
                            <span class="workflow-number">01</span>
                            <h6 class="fw-bold mt-3 mb-1">Assigned</h6>
                            <p class="small text-secondary mb-0">
                                Check the order details.
                            </p>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="workflow-step">
                            <span class="workflow-number">02</span>
                            <h6 class="fw-bold mt-3 mb-1">Prepare</h6>
                            <p class="small text-secondary mb-0">
                                Confirm the order is ready.
                            </p>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="workflow-step">
                            <span class="workflow-number">03</span>
                            <h6 class="fw-bold mt-3 mb-1">On the Way</h6>
                            <p class="small text-secondary mb-0">
                                Update the delivery status.
                            </p>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="workflow-step">
                            <span class="workflow-number">04</span>
                            <h6 class="fw-bold mt-3 mb-1">Delivered</h6>
                            <p class="small text-secondary mb-0">
                                Mark the order delivered.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .delivery-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease,
                    border-color 0.25s ease;
        background: #fff;
    }

    .delivery-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(24, 60, 40, 0.10) !important;
        border-color: #198754 !important;
    }

    .delivery-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.35rem;
    }

    .workflow-step {
        height: 100%;
        padding: 18px;
        border: 1px solid #edf0ed;
        border-radius: 14px;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .workflow-step:hover {
        background: #f4faf6;
        border-color: #b9dfc7;
    }

    .workflow-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #e3f4e9;
        color: #198754;
        font-weight: 700;
        font-size: 0.9rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .delivery-card,
        .workflow-step {
            transition: none;
        }

        .delivery-card:hover {
            transform: none;
        }
    }
</style>

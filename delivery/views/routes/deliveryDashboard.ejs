
<%- layout("/boilerplate/deliveryBoiler") %>

<div class="container-fluid px-3 px-md-4 py-4 delivery-dashboard">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-success fw-semibold small mb-2">
                <i class="fa-solid fa-location-dot me-1"></i>
                DELIVERY PARTNER / OVERVIEW
            </p>

            <h2 class="fw-bold mb-2 dashboard-title">Delivery Dashboard</h2>

            <p class="text-secondary mb-0">
                Welcome back, Delivery Partner!
            </p>
        </div>

        <a href="/delivery/orders/assign/delivered"
           class="btn btn-success px-4 py-3 rounded-3 fw-semibold dashboard-button">
            <i class="fa-solid fa-arrow-right me-2"></i>
            View My Deliveries
        </a>
    </div>

    <!-- Main Banner -->
    <div class="dashboard-banner rounded-4 p-4 p-md-5 mb-4 text-white position-relative overflow-hidden">

        <div class="row align-items-center">
            <div class="col-md-8 position-relative banner-content">
                <span class="badge bg-white text-success rounded-pill px-3 py-2 mb-3">
                    <i class="fa-solid fa-truck-fast me-2"></i>
                    Delivery Partner Portal
                </span>

                <h1 class="fw-bold mb-3 banner-title">
                    Manage your deliveries.
                </h1>

                <p class="mb-4 banner-description">
                    Manage assigned orders, update delivery statuses, and help
                    customers receive their purchases on time.
                </p>

            </div>

            <div class="col-md-4 text-md-end mt-4 mt-md-0 text-center">
                <div class="banner-icon">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Section Heading -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-1">Delivery Management</h5>
            <p class="text-secondary small mb-0">
                Manage your assigned and completed deliveries.
            </p>
        </div>
    </div>

    <!-- Management Cards -->
    <div class="row g-3">

        <!-- Assigned Orders -->
        <div class="col-md-6 col-xl-4">
            <a href="/delivery/orders/assign"
               class="text-decoration-none text-dark">
                <div class="card delivery-card h-100">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="delivery-icon assigned-icon">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </div>

                            <span class="card-number">01</span>
                        </div>

                        <h5 class="fw-bold mb-2">Assigned Orders</h5>

                        <p class="text-secondary small mb-4 card-description">
                            Check the orders assigned to you and review their details.
                        </p>

                        <div class="card-action text-primary">
                            View Assigned Orders
                            <i class="fa-solid fa-arrow-right ms-2"></i>
                        </div>

                    </div>
                </div>
            </a>
        </div>

        <!-- Out for Delivery -->
        <div class="col-md-6 col-xl-4">
            <a href="/delivery/orders/assign/out-for-delivery"
               class="text-decoration-none text-dark">
                <div class="card delivery-card h-100">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="delivery-icon active-icon">
                                <i class="fa-solid fa-truck-fast"></i>
                            </div>

                            <span class="card-number">02</span>
                        </div>

                        <h5 class="fw-bold mb-2">Out for Delivery</h5>

                        <p class="text-secondary small mb-4 card-description">
                            Access your delivery list and update orders when they are on the way.
                        </p>

                        <div class="card-action active-action">
                            Manage Deliveries
                            <i class="fa-solid fa-arrow-right ms-2"></i>
                        </div>

                    </div>
                </div>
            </a>
        </div>

        <!-- Completed Deliveries -->
        <div class="col-md-6 col-xl-4">
            <a href="/delivery/orders/assign/delivered"
               class="text-decoration-none text-dark">
                <div class="card delivery-card h-100">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="delivery-icon completed-icon">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>

                            <span class="card-number">03</span>
                        </div>

                        <h5 class="fw-bold mb-2">Completed Deliveries</h5>

                        <p class="text-secondary small mb-4 card-description">
                            Review completed orders and keep track of your delivery work.
                        </p>

                        <div class="card-action text-success">
                            View Order History
                            <i class="fa-solid fa-arrow-right ms-2"></i>
                        </div>

                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- Workflow -->
    <div class="mt-4">
        <div class="mb-3">
            <h5 class="fw-bold mb-1">Delivery Workflow</h5>
            <p class="text-secondary small mb-0">
                Follow these steps to complete your deliveries.
            </p>
        </div>

        <div class="card workflow-card">
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">

                    <div class="col-6 col-lg-3">
                        <div class="workflow-step">
                            <span class="workflow-number">01</span>
                            <h6 class="fw-bold mt-3 mb-2">Assigned</h6>
                            <p class="small text-secondary mb-0">
                                Check the order details.
                            </p>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="workflow-step">
                            <span class="workflow-number">02</span>
                            <h6 class="fw-bold mt-3 mb-2">Prepare</h6>
                            <p class="small text-secondary mb-0">
                                Confirm the order is ready.
                            </p>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="workflow-step">
                            <span class="workflow-number">03</span>
                            <h6 class="fw-bold mt-3 mb-2">On the Way</h6>
                            <p class="small text-secondary mb-0">
                                Update the delivery status.
                            </p>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="workflow-step">
                            <span class="workflow-number">04</span>
                            <h6 class="fw-bold mt-3 mb-2">Delivered</h6>
                            <p class="small text-secondary mb-0">
                                Mark the order delivered.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .delivery-dashboard {
        color: #24352b;
    }

    .dashboard-title {
        letter-spacing: -0.7px;
    }

    .dashboard-button {
        box-shadow: 0 4px 12px rgba(25, 135, 84, 0.12);
    }

    /* Main banner */
    .dashboard-banner {
        background: linear-gradient(115deg, #123b2a, #198754);
        box-shadow: 0 8px 24px rgba(18, 59, 42, 0.12);
    }

    .banner-content {
        z-index: 1;
    }

    .banner-title {
        font-size: clamp(1.8rem, 4vw, 2.7rem);
        letter-spacing: -1px;
    }

    .banner-description {
        max-width: 500px;
        color: #e1f4e8;
        line-height: 1.8;
    }

    .banner-icon {
        font-size: clamp(5rem, 12vw, 9rem);
        color: rgba(255, 255, 255, 0.2);
        line-height: 1;
    }

    /* Management cards: no hover effects */
    .delivery-card {
        height: 100%;
        background: #fff;
        border: 1px solid #e2e8e3;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(24, 60, 40, 0.045);
    }

    .delivery-icon {
        width: 56px;
        height: 56px;
        border-radius: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.35rem;
    }

    .assigned-icon {
        background: #e8f0ff;
        color: #3867d6;
    }

    .active-icon {
        background: #fff2df;
        color: #d98200;
    }

    .completed-icon {
        background: #e1f7e9;
        color: #198754;
    }

    .card-number {
        font-size: 0.8rem;
        font-weight: 700;
        color: #9aa79e;
        background: #f5f8f5;
        padding: 6px 10px;
        border-radius: 8px;
    }

    .card-description {
        line-height: 1.7;
        min-height: 48px;
    }

    .card-action {
        font-size: 0.88rem;
        font-weight: 700;
    }

    .active-action {
        color: #b87500;
    }

    /* Workflow */
    .workflow-card {
        border: 1px solid #e2e8e3;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(24, 60, 40, 0.035);
    }

    .workflow-step {
        height: 100%;
        padding: 18px;
        background: #f9fbf9;
        border: 1px solid #edf0ed;
        border-radius: 13px;
    }

    .workflow-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #e3f4e9;
        color: #198754;
        font-weight: 700;
        font-size: 0.9rem;
    }

    /* Keep interactions static: no hover animations or color changes */
    .delivery-card,
    .workflow-step,
    .delivery-dashboard a,
    .delivery-dashboard .btn {
        transition: none !important;
        transform: none !important;
    }

    @media (max-width: 575.98px) {
        .dashboard-banner {
            padding: 24px !important;
        }

        .dashboard-title {
            font-size: 1.65rem;
        }

        .card-description {
            min-height: 0;
        }

        .workflow-step {
            padding: 14px;
        }
    }
</style>
